{
  "name": "strydegosox-commerce-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready commerce backend for StrydeGoSox",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "SERVE_FRONTEND=true node src/server.js",
    "seed": "node seed.js",
    "check": "node --check src/server.js && node --check src/routes/auth.js && node --check src/routes/checkout.js && node --check src/routes/payments.js && node --check src/routes/admin.js && node --check src/middleware/auth.js && node --check src/utils/orders.js && node --check src/utils/email.js && node --check production-qa.js",
    "qa": "npm run check && node production-qa.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.6",
    "resend": "^6.30.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "qs": "^6.16.2",
    "minimatch": "^11.0.1"
  }
}
