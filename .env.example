# StrydeGoSox environment template
# NEVER put real production secrets in this file.
NODE_ENV=development
PORT=5000
PUBLIC_APP_URL=http://localhost:5501
ADMIN_URL=http://localhost:5501/admin/admin.html

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/strydegosox
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_EMAIL=admin@strydegosox.com
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_PRODUCTION

RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_WEBHOOK_SECRET

STORE_CURRENCY=INR
FREE_SHIPPING_THRESHOLD=1999
SHIPPING_FEE=99
PRODUCT_SALES_TAX_RATE=0

SERVE_FRONTEND=false

RESEND_API_KEY=re_replace_me_with_your_resend_api_key
EMAIL_FROM="StrydeGoSox <orders@your-verified-domain.com>"
EMAIL_REPLY_TO="support@your-verified-domain.com"
STORE_URL=https://yourdomain.com

# Authentication cookie policy. Use "lax" when frontend/API share a site;
# use "none" only when they are on different sites and HTTPS is enabled.
AUTH_COOKIE_SAMESITE=lax

# GST registration shown on invoices and emails
BUSINESS_GSTIN=REPLACE_WITH_YOUR_BUSINESS_GSTIN
DEV_TUNNEL_ORIGIN=
QA_BASE_URL=http://127.0.0.1:5000

# Optional recipient for the manual test-email.js script
TEST_EMAIL_TO=
